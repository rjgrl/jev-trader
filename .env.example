# Trading
TRADING_MODE=dry-run
ALLOW_LIVE_TRADING=false
MT5_SYMBOL=XAUUSD

# MT5 Bridge
MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_BRIDGE_TOKEN=

# MT5 Terminal (for the Python bridge)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Risk
MAX_POSITION_SIZE=1.0
MAX_LOSS_PER_TRADE=100
MAX_DAILY_LOSS=500
MAX_TOTAL_EXPOSURE=2.0
MAX_SPREAD_BPS=50
MAX_SLIPPAGE_POINTS=10

# Strategy
TIMEFRAME=M1
DECISION_INTERVAL_MS=1000
MIN_CONFIDENCE=0.55

# Stop Loss / Take Profit
ENABLE_STOP_LOSS=false
STOP_LOSS_POINTS=500
ENABLE_TAKE_PROFIT=false
TAKE_PROFIT_POINTS=1000

# Position Management
ALLOW_PYRAMIDING=false
REVERSE_ON_OPPOSITE_SIGNAL=false

# Model
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
JEV_USD_PER_MTOK=0.042

# Server
PORT=3000
HISTORY_SIZE=1000